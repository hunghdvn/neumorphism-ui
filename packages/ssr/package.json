{
  "name": "@neumorphism-ui/ssr",
  "version": "1.0.0-next.3",
  "description": "Server-side rendering helpers for neumorphism-ui",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunghdvn/neumorphism-ui.git",
    "directory": "packages/ssr"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "default": "./dist/nuxt/module.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm --filter @neumorphism-ui/elements build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@neumorphism-ui/elements": "workspace:*"
  },
  "peerDependencies": {
    "@nuxt/kit": "^4.0.0",
    "@nuxt/schema": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "4.5.2",
    "@nuxt/schema": "4.5.2"
  }
}
