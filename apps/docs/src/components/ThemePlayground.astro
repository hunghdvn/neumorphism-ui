---
---

<div class="playground not-content" data-playground>
  <div class="controls">
    <label class="color">
      <span>--neu-bg</span>
      <input type="color" data-color="bg" value="#e0e5ec" />
    </label>
    <label class="color">
      <span>--neu-accent</span>
      <input type="color" data-color="accent" value="#6d5dfc" />
    </label>
    <neu-slider
      data-var="--neu-distance"
      data-unit="px"
      label="--neu-distance"
      min="0"
      max="20"
      step="1"
      value="6"
    ></neu-slider>
    <neu-slider
      data-var="--neu-intensity"
      data-unit=""
      label="--neu-intensity"
      min="0"
      max="2"
      step="0.1"
      value="1"
    ></neu-slider>
    <neu-slider
      data-var="--neu-radius"
      data-unit="px"
      label="--neu-radius"
      min="0"
      max="32"
      step="1"
      value="12"
    ></neu-slider>
    <neu-switch data-playground-dark>Dark theme</neu-switch>
  </div>

  <div class="preview neu-surface" data-playground-preview data-neu-theme="light">
    <neu-button variant="primary">Save</neu-button>
    <neu-text-field label="Name" value="Ada"></neu-text-field>
    <neu-switch checked>Notifications</neu-switch>
    <neu-checkbox checked>Remember me</neu-checkbox>
    <neu-slider label="Volume" value="40"></neu-slider>
    <neu-surface class="sample">A raised surface</neu-surface>
  </div>

  <pre class="css" data-playground-css aria-label="CSS for the changed variables"></pre>

  <!-- The defaults are read from the tokens through these, so they never go stale. -->
  <div hidden data-playground-probe="light" data-neu-theme="light"></div>
  <div hidden data-playground-probe="dark" data-neu-theme="dark"></div>
</div>

<style>
  .playground {
    display: grid;
    gap: 1.5rem;
    margin-block: 2rem;
  }
  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.25rem;
    align-items: center;
  }
  .color {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
  }
  .color input {
    inline-size: 3rem;
    block-size: 2rem;
    padding: 0;
    border: 0;
    background: none;
  }
  .preview {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem;
  }
  .sample {
    padding: 1rem;
  }
  .css {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-nav);
    font-size: var(--sl-text-sm);
  }
</style>

<script>
  import '@neumorphism-ui/elements/all.js';

  type ThemeName = 'light' | 'dark';
  type ColorKey = 'bg' | 'accent';
  type Colors = Partial<Record<ColorKey, string>>;

  const colorVars: Record<ColorKey, string> = { bg: '--neu-bg', accent: '--neu-accent' };

  /** Lower-case `#rrggbb`, the form `<input type="color">` reads and writes. */
  function hex(color: string): string {
    const value = color.trim().toLowerCase();
    const short = /^#([0-9a-f])([0-9a-f])([0-9a-f])$/.exec(value);
    return short ? `#${short[1]!.repeat(2)}${short[2]!.repeat(2)}${short[3]!.repeat(2)}` : value;
  }

  /**
   * One theme's overrides, written for where that theme is active: on an element that sets it,
   * and on a page that follows the OS. Unlayered CSS beats the tokens' layer, so a block that
   * also matched elsewhere (a bare `:root`) would put one theme's colours under the other.
   */
  function themeCss(name: ThemeName, lines: string[]): string {
    const other: ThemeName = name === 'light' ? 'dark' : 'light';
    const nested = lines.map((line) => `  ${line}`);
    return [
      `[data-neu-theme='${name}'] {`,
      ...lines,
      '}',
      `@media (prefers-color-scheme: ${name}) {`,
      `  :root:not([data-neu-theme='${other}']) {`,
      ...nested,
      '  }',
      '}',
    ].join('\n');
  }

  const root = document.querySelector<HTMLElement>('[data-playground]');
  if (root) {
    const preview = root.querySelector<HTMLElement>('[data-playground-preview]')!;
    const output = root.querySelector<HTMLElement>('[data-playground-css]')!;
    const darkSwitch = root.querySelector<HTMLElement & { checked: boolean }>(
      '[data-playground-dark]',
    )!;
    const sliders = [
      ...root.querySelectorAll<HTMLElement & { value: unknown }>('neu-slider[data-var]'),
    ];
    const pickers = [...root.querySelectorAll<HTMLInputElement>('input[data-color]')];
    const token = (theme: ThemeName, name: string) =>
      getComputedStyle(root.querySelector(`[data-playground-probe="${theme}"]`)!)
        .getPropertyValue(name)
        .trim();
    const defaults: Record<ThemeName, Record<ColorKey, string>> = {
      light: { bg: hex(token('light', '--neu-bg')), accent: hex(token('light', '--neu-accent')) },
      dark: { bg: hex(token('dark', '--neu-bg')), accent: hex(token('dark', '--neu-accent')) },
    };
    // Colours are written only once the user changes them, per theme.
    const edited: Record<ThemeName, Colors> = { light: {}, dark: {} };
    // Read from the switch on every render: a reload or a back navigation may restore it after
    // this script has run, and a restore fires no event (pageshow re-renders after it).
    const theme = (): ThemeName => (darkSwitch.checked ? 'dark' : 'light');

    const sliderValue = (el: HTMLElement & { value: unknown }) => Number(el.value);
    const changedLengths = () =>
      sliders
        .filter(
          (el) => sliderValue(el) !== Number.parseFloat(token('light', el.dataset.var!)),
        )
        .map((el) => `  ${el.dataset.var}: ${sliderValue(el)}${el.dataset.unit ?? ''};`);

    function render(): void {
      const current = theme();
      preview.dataset.neuTheme = current;
      for (const [key, name] of Object.entries(colorVars) as [ColorKey, string][]) {
        const value = edited[current][key];
        if (value) preview.style.setProperty(name, value);
        else preview.style.removeProperty(name);
      }
      for (const el of sliders) {
        preview.style.setProperty(el.dataset.var!, `${sliderValue(el)}${el.dataset.unit ?? ''}`);
      }
      for (const picker of pickers) {
        const key = picker.dataset.color as ColorKey;
        picker.value = edited[current][key] ?? defaults[current][key];
      }

      const blocks: string[] = [];
      const lengths = changedLengths();
      if (lengths.length) blocks.push(`:root {\n${lengths.join('\n')}\n}`);
      for (const name of ['light', 'dark'] as const) {
        const lines = (Object.entries(colorVars) as [ColorKey, string][])
          .filter(([key]) => edited[name][key])
          .map(([key, variable]) => `  ${variable}: ${edited[name][key]};`);
        if (lines.length) blocks.push(themeCss(name, lines));
      }
      output.textContent = blocks.length
        ? blocks.join('\n\n')
        : '/* Nothing changed: every variable has its default. */';
    }

    for (const el of sliders) el.addEventListener('input', render);
    for (const picker of pickers) {
      picker.addEventListener('input', () => {
        const key = picker.dataset.color as ColorKey;
        const current = theme();
        const value = hex(picker.value);
        if (value === defaults[current][key]) delete edited[current][key];
        else edited[current][key] = value;
        render();
      });
    }
    darkSwitch.addEventListener('change', render);
    window.addEventListener('pageshow', render);
    render();
  }
</script>
