---
import { componentDocs } from '@neumorphism-ui/elements/docs.js';

interface Props {
  tag: string;
}

const { tag } = Astro.props;
const keyboard = componentDocs.get(tag)?.keyboard ?? [];
---

{keyboard.length > 0 && (
  <table data-table="keyboard">
    <thead>
      <tr>
        <th>Key</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {keyboard.map((entry) => (
        <tr>
          <td>
            <code>{entry.name}</code>
          </td>
          <td>{entry.description}</td>
        </tr>
      ))}
    </tbody>
  </table>
)}
